# =============================================================================
#  .gitignore — Gerado por gitignore-bootstrap.sh
#  Data: 2026-06-17
#  Stacks: node-typescript python php-laravel go rust infra-terraform-k8s
#
#  NOTA: Este arquivo combina o global + templates por stack.
#  O global já é aplicado via git config --global core.excludesFile
#  então as seções 1-24 (segredos, OS, IDEs) são duplicação proposital
#  para que o repo funcione standalone em clones de outras pessoas.
# =============================================================================


